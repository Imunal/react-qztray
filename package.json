{
	"name": "react-qztray",
	"version": "0.0.0",
	"description": "React hooks for seamless integration with QZ Tray (qz.io)",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"packageManager": "pnpm@10.32.1",
	"keywords": [
		"qz tray",
		"qz react",
		"qz tray react",
		"qz tray",
		"qz.io"
	],
	"author": "Juliusz Kowalewski @Imunal",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Imunal/react-qztray/issues"
	},
	"homepage": "https://github.com/Imunal/react-qztray",
	"repository": {
		"type": "github",
		"url": "https://github.com/Imunal/react-qztray"
	},
	"scripts": {
		"dev": "tsup src/index.ts --watch",
		"build": "tsup src/index.ts --format cjs,esm --dts",
		"lint": "biome lint --write",
		"format": "biome format --write",
		"check": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky",
		"playground": "pnpm --filter playground dev"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"qz-tray": "^2.2.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/qz-tray": "^2.2.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"husky": "^9.1.7",
		"jsdom": "^29.0.0",
		"react": "^19",
		"react-dom": "^19",
		"semantic-release": "^25.0.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	}
}
